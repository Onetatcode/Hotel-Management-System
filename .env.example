# Copy this file to .env and fill in your real values.
# The anon (publishable) key is safe for client apps; never add the secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# OpenRouter API key for the Assistant (chatbot) feature. Create one at
# https://openrouter.ai/keys and add credits to use paid models (e.g. x-ai/grok-4.6).
# The key stays in .env only (git-ignored) — never hardcode or commit it.
OPENROUTER_API_KEY=your-openrouter-api-key
